# Supabase — public/client-safe values (protected by Row Level Security, fine to expose)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same values, VITE_-prefixed so the browser bundle can read them via import.meta.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-only secret. NEVER commit a real value here.
# Fetch from Supabase dashboard > Settings > API > service_role key,
# then set it with: wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Square — public/client-safe values (the location id is already public in
# Kaaya's Square-hosted booking URL). Set in wrangler.jsonc `vars`, not here.
# SQUARE_LOCATION_ID=
# SQUARE_ENVIRONMENT=sandbox|production

# Square — server-only secret. NEVER commit a real value here.
# Fetch from Square Developer dashboard > your app > Credentials, then set
# it with: wrangler secret put SQUARE_ACCESS_TOKEN
SQUARE_ACCESS_TOKEN=

# Square — local dev only, in .dev.vars (gitignored), never here or in
# wrangler.jsonc/production. "true" swaps the real Square client for a
# fixture-backed mock so the booking flow can be built/tested with no
# Square credentials at all.
# SQUARE_MOCK_MODE=true

# Cloudflare — used by CI/CD only. Set as GitHub Actions repo secrets,
# never put real values in this file or commit them.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
